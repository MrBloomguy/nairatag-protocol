# ==================================================
# Profile: dev-opstack (Example / Pending Implementation)
# Description: Genuine Local OP Stack Rollup
# Use: Full rollup execution, derivation, batching, and cross-domain bridging
# Prerequisites: Docker Desktop / WSL2, op-node, op-geth, op-batcher
# ==================================================

PROFILE=dev-opstack
ENVIRONMENT_NAME="Genuine OP Stack Local Rollup"
IS_OP_STACK_ROLLUP=true

# Network Identity
NAIRATAG_NETWORK_NAME="NairaTag L2"
NAIRATAG_SHORT_NAME="NairaTag-L2"
NAIRATAG_CHAIN_ID=901
NAIRATAG_NATIVE_SYMBOL=ETH
NAIRATAG_NATIVE_NAME=Ether
NAIRATAG_NATIVE_DECIMALS=18

# Layer 1 Settlement (Anvil)
L1_NETWORK=local-anvil
L1_CHAIN_ID=900
L1_RPC_URL=http://127.0.0.1:8545
L1_HTTP_PORT=8545

# Layer 2 Execution (op-geth / op-reth)
L2_NETWORK=opstack-local
L2_CHAIN_ID=901
L2_RPC_URL=http://127.0.0.1:9545
L2_ENGINE_URL=http://127.0.0.1:8551
L2_HTTP_PORT=9545
L2_ENGINE_PORT=8551

# OP Stack Daemons
OP_NODE_RPC_URL=http://127.0.0.1:8547
OP_NODE_PORT=8547
BATCHER_RPC_URL=http://127.0.0.1:8548
PROPOSER_RPC_URL=http://127.0.0.1:8549

# Canonical L1 Bedrock Contract Addresses (Populated upon DeployBedrock)
L1_OPTIMISM_PORTAL_PROXY=
L1_SYSTEM_CONFIG_PROXY=
L1_L2_OUTPUT_ORACLE_PROXY=
L1_CROSS_DOMAIN_MESSENGER_PROXY=
L1_STANDARD_BRIDGE_PROXY=
L1_ADDRESS_MANAGER=
