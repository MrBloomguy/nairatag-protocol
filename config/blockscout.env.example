# ==============================================================================
# NairaTag Network — Blockscout Configuration Example
# ==============================================================================

# Target Layer 2 Rollup RPC (Blockscout indexes NairaTag L2, NOT Anvil directly)
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:9545
ETHEREUM_JSONRPC_WS_URL=ws://host.docker.internal:9545
CHAIN_ID=901

# Network Branding
NETWORK=NairaTag Network
SUBNETWORK=NairaTag L2 Devnet
COIN=ETH
COIN_NAME=Ether

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/blockscout?ssl=false
ECTO_USE_SSL=false

# Explorer Ports & Server
PORT=4000
BLOCKSCOUT_HOST=localhost
BLOCKSCOUT_PORT=4000
FRONTEND_PORT=3000
API_V2_ENABLED=true

# Indexer Options for Local Devnet
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=false
INDEXER_EMPTY_BLOCKS_SANITIZER_ENABLED=true
INDEXER_MEMORY_LIMIT=2GB
DISABLE_EXCHANGE_RATES=true
