# ==================================================
# Profile: testnet (Example / Public Testnet)
# Description: NairaTag Network on Ethereum Sepolia
# Use: Public staging and testnet validation
# ==================================================

PROFILE=testnet
ENVIRONMENT_NAME="Public OP Stack Sepolia Testnet"
IS_OP_STACK_ROLLUP=true

# Network Identity
NAIRATAG_NETWORK_NAME="NairaTag Sepolia Testnet"
NAIRATAG_SHORT_NAME="NairaTag-Sepolia"
NAIRATAG_CHAIN_ID=901
NAIRATAG_NATIVE_SYMBOL=ETH
NAIRATAG_NATIVE_NAME=Ether
NAIRATAG_NATIVE_DECIMALS=18

# Layer 1 Settlement (Ethereum Sepolia)
L1_NETWORK=sepolia
L1_CHAIN_ID=11155111
L1_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Layer 2 Execution (NairaTag Sepolia RPC)
L2_NETWORK=sepolia-testnet
L2_CHAIN_ID=901
L2_RPC_URL=https://sepolia-rpc.nairatag.network

# Explorer
EXPLORER_URL=https://sepolia.nairatagscan.io
