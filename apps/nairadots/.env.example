# Network & RPC Configuration
VITE_ARC_NETWORK=testnet
VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.io
VITE_ARC_TESTNET_CHAIN_ID=5042002
VITE_ARC_TESTNET_EXPLORER=https://explorer.testnet.arc.io
VITE_ARC_TESTNET_USDC=0x3600000000000000000000000000000000000000

VITE_ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
VITE_ARC_MAINNET_CHAIN_ID=5042
VITE_ARC_MAINNET_EXPLORER=https://explorer.arc.io
VITE_ARC_MAINNET_USDC=0x3600000000000000000000000000000000000000

# Canonical NairaTag Resolver Endpoint (reuses canonical registry)
VITE_NAIRATAG_RESOLVER_API=https://nairatag.ng/api/claims
# Public origin of the separately deployed persistent OpenDots-derived runtime.
VITE_NAIRADOTS_AGENT_URL=
VITE_SUPABASE_URL=https://bbpdupijsgdghemfpijr.supabase.co
VITE_SUPABASE_ANON_KEY=

# Circle User-Controlled Wallets (email OTP)
VITE_CIRCLE_APP_ID=
# Server-only Circle Standard API key. Never prefix this with VITE_.
CIRCLE_API_KEY=

# Server-only Gemini API key for opt-in selfie-to-caricature portraits.
GEMINI_API_KEY=
# Set true only when this key is on Gemini's paid tier (production photo privacy).
GEMINI_API_PAID_TIER=false
# Must match the shared session signer used by NairaTag wallet/Circle auth.
ARC_SESSION_SECRET=
# Optional model override; defaults to gemini-nano-banana-2.1.
GEMINI_IMAGE_MODEL=

# Telegram channel alerts (server-only; never prefix the bot token with VITE_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1003984230029
