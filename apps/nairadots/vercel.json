{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agent/:handle",
      "destination": "/api/agent?handle=:handle"
    },
    {
      "source": "/tag/:handle",
      "destination": "/api/tag?handle=:handle"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_APP_NAME": "NairaDots",
    "VITE_NAIRATAG_API_URL": "https://nairatag.ng/api"
  }
}
