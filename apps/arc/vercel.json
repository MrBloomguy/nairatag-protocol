{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/agent/:handle",
      "destination": "/api/agent?handle=:handle"
    },
    {
      "source": "/tag/:handle",
      "destination": "/api/tag?handle=:handle"
    },
    {
      "source": "/cards/:handle",
      "destination": "/api/cards?handle=:handle"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

