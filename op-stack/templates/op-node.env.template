# ==============================================================================
# NairaTag Network — op-node Environment Configuration Template
# ==============================================================================

# L1 Connection
OP_NODE_L1_ETH_RPC=http://127.0.0.1:8545
OP_NODE_L1_BEACON_IGNORE=true
OP_NODE_L1_RPCKIND=basic

# L2 Execution Engine Connection (Authenticated)
OP_NODE_L2_ENGINE_RPC=http://127.0.0.1:8551
OP_NODE_L2_JWT_SECRET_PATH=<REQUIRED_PATH_TO_JWT_HEX_FILE>

# Rollup Specification
OP_NODE_ROLLUP_CONFIG_PATH=<REQUIRED_PATH_TO_ROLLUP_JSON_FILE>

# Sequencer Configuration
OP_NODE_SEQUENCER_ENABLED=true
OP_NODE_SEQUENCER_L1_CONFS=0
OP_NODE_VERIFIER_L1_CONFS=0

# RPC Server
OP_NODE_RPC_ADDR=0.0.0.0
OP_NODE_RPC_PORT=8547

# P2P Network (Disabled for local devnet)
OP_NODE_P2P_DISABLE=true
