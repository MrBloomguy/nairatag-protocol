# ==============================================================================
# NairaTag Network — op-batcher Environment Configuration Template
# ==============================================================================

# RPC Endpoints
OP_BATCHER_L1_ETH_RPC=http://127.0.0.1:8545
OP_BATCHER_L2_ETH_RPC=http://127.0.0.1:9545
OP_BATCHER_ROLLUP_RPC=http://127.0.0.1:8547

# Batcher Submission Parameters
OP_BATCHER_POLL_INTERVAL=1s
OP_BATCHER_SUB_SAFETY_MARGIN=4
OP_BATCHER_NUM_CONFIRMATIONS=1
OP_BATCHER_SAFE_ABORT_NONCE_TOO_LOW_COUNT=3

# Submitter Private Key (Must match batcherAddr in rollup.json and SystemConfig)
OP_BATCHER_PRIVATE_KEY=<REQUIRED_BATCHER_PRIVATE_KEY_FUNDED_ON_L1>
