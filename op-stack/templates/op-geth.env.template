# ==============================================================================
# NairaTag Network — op-geth Environment Configuration Template
# ==============================================================================

# Data & Network Identity
OP_GETH_DATADIR=/data
OP_GETH_NETWORK_ID=901

# Public JSON-RPC
OP_GETH_HTTP_ADDR=0.0.0.0
OP_GETH_HTTP_PORT=8545
OP_GETH_HTTP_API=eth,net,web3,debug,txpool
OP_GETH_HTTP_CORSDOMAIN=*
OP_GETH_HTTP_VHOSTS=*

# Authenticated Engine API (for op-node)
OP_GETH_AUTHRPC_ADDR=0.0.0.0
OP_GETH_AUTHRPC_PORT=8551
OP_GETH_AUTHRPC_VHOSTS=*
OP_GETH_AUTHRPC_JWTSECRET=<REQUIRED_PATH_TO_JWT_HEX_FILE>

# Node Behavior
OP_GETH_NODISCOVER=true
OP_GETH_SYNCMODE=full
OP_GETH_GCMODE=archive
OP_GETH_ROLLUP_DISABLETXPOOLGOSSIP=true
